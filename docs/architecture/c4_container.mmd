C4Container
    title Container Diagram - EventWeather PL

    Person(user, "Uzytkownik", "Przegladarka internetowa")
    System_Ext(ticketmaster, "Ticketmaster API", "Zewnetrzne API wydarzen")
    System_Ext(openweather, "OpenWeatherMap API", "Zewnetrzne API pogody")

    System_Boundary(eventweather, "EventWeather PL") {
        Container(frontend, "Frontend", "HTML + Bootstrap + Chart.js", "Strona WWW: przeglad wydarzen, ikonki pogody, ranking miast")
        Container(backend, "Backend API", "Python / FastAPI", "REST API: /events /cities /ranking. Automatyczny Swagger pod /docs")
        Container(ingestion, "Ingestion Service", "Python / APScheduler", "Pobiera dane co 6h z obu API dla 8 polskich miast")
        Container(processing, "Processing Module", "Python", "Laczy wydarzenie z prognoza. Oblicza weather_score 0-100.")
        ContainerDb(database, "Baza Danych", "PostgreSQL 16", "Tabele: events, forecasts, weather_scores")
    }

    Rel(user, frontend, "Otwiera strone", "HTTPS")
    Rel(frontend, backend, "Odpytuje dane", "REST / JSON")
    Rel(backend, database, "Odczytuje dane", "SQL")
    Rel(ingestion, ticketmaster, "Pobiera wydarzenia co 6h", "REST / JSON")
    Rel(ingestion, openweather, "Pobiera prognozy co 6h", "REST / JSON")
    Rel(ingestion, processing, "Przekazuje surowe dane", "funkcja Python")
    Rel(processing, database, "Zapisuje przetworzone dane", "SQL")
