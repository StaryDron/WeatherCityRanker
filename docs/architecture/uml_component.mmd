graph TB
    subgraph EXT["Zewnetrzne zrodla danych"]
        TM["Ticketmaster API REST/JSON"]
        OW["OpenWeatherMap API REST/JSON"]
    end

    subgraph DOCKER["Docker Network: eventweather_network"]
        subgraph ING["ingestion container"]
            SCHED["Scheduler APScheduler co 6h"]
            TM_C["TicketmasterClient requests"]
            OW_C["OpenWeatherClient requests"]
        end
        subgraph PROC["processing container"]
            NORM["DataNormalizer laczy eventi z pogoda"]
            SCORER["WeatherScorer weather_score 0-100"]
        end
        subgraph BE["backend container"]
            API["FastAPI REST endpoints"]
            SWG["Swagger UI /docs"]
        end
        subgraph DB["db container"]
            PG[("PostgreSQL 16\nevents / forecasts / scores")]
        end
        subgraph FE["frontend container"]
            NGX["Nginx pliki statyczne"]
            HTML["HTML + JS + Chart.js"]
        end
    end

    USER(("Uzytkownik"))
    SCHED --> TM_C & OW_C
    TM_C -->|HTTP GET| TM
    OW_C -->|HTTP GET| OW
    TM_C & OW_C --> NORM --> SCORER -->|INSERT SQL| PG
    API -->|SELECT SQL| PG
    SWG --> API
    NGX --> HTML
    HTML -->|fetch REST| API
    USER -->|HTTPS| NGX
